{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "estimate.schema.json",
  "title": "Materials estimate",
  "description": "Indicative concrete and steel quantities for one project. Always a range. Populated in M5.",
  "type": "object",
  "required": ["id", "project_id", "tier", "method_version", "concrete_m3", "steel_t", "assumptions", "reviewed_by", "reviewed_at"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string"},
    "project_id": {"type": "string"},
    "tier": {"enum": ["A", "B", "C"]},
    "method_version": {"type": "string", "pattern": "^v\\d+\\.\\d+$"},
    "concrete_m3": {"$ref": "#/$defs/range"},
    "steel_t": {"$ref": "#/$defs/range"},
    "assumptions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["text"],
        "properties": {"text": {"type": "string"}, "source_id": {"type": "string"}, "benchmark_id": {"type": "string"}}
      }
    },
    "reviewed_by": {"type": ["string", "null"]},
    "reviewed_at": {"type": ["string", "null"]}
  },
  "$defs": {
    "range": {
      "type": "object",
      "required": ["low", "likely", "high"],
      "properties": {"low": {"type": "number"}, "likely": {"type": "number"}, "high": {"type": "number"}}
    }
  }
}
