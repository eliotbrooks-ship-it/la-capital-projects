{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project.schema.json",
  "title": "Project",
  "description": "One Louisiana capital project of $10M+. Every factual field must trace to a source_id. Enforced by scripts/validate.py.",
  "type": "object",
  "required": [
    "id",
    "name",
    "owner_company",
    "type",
    "parish",
    "capex_values",
    "headline_capex_usd",
    "tier",
    "status",
    "status_source_id",
    "phases",
    "confidence",
    "first_seen",
    "last_verified",
    "source_ids"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string"
    },
    "owner_company": {
      "type": "string"
    },
    "type": {
      "enum": [
        "data_center",
        "lng",
        "chemicals",
        "ammonia_hydrogen",
        "steel_metals",
        "manufacturing",
        "spaceport_aerospace",
        "power_generation",
        "infrastructure",
        "other"
      ]
    },
    "parish": {
      "type": "string",
      "description": "Parish name without the word 'Parish', e.g. 'Ascension'."
    },
    "lat": {
      "type": [
        "number",
        "null"
      ]
    },
    "lon": {
      "type": [
        "number",
        "null"
      ]
    },
    "location_precision": {
      "enum": [
        "exact",
        "approximate",
        "parish"
      ],
      "description": "approximate = hand-placed near a named community; parish = parish centroid only."
    },
    "location_note": {
      "type": "string"
    },
    "capex_values": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "value_usd",
          "basis",
          "source_id",
          "as_of"
        ],
        "additionalProperties": false,
        "properties": {
          "value_usd": {
            "type": "number",
            "minimum": 0
          },
          "basis": {
            "enum": [
              "capex",
              "financing",
              "commitment"
            ],
            "description": "capex = stated investment/capital cost; financing = financing raised; commitment = spending commitments."
          },
          "source_id": {
            "type": "string"
          },
          "as_of": {
            "type": "string",
            "description": "YYYY-MM-DD, YYYY-MM or YYYY"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "headline_capex_usd": {
      "type": "number",
      "minimum": 10000000
    },
    "tier": {
      "enum": [
        "A",
        "B",
        "C"
      ],
      "description": "A >= $1B; B $100M-$1B; C $10M-$100M. Derived from headline_capex_usd."
    },
    "status": {
      "enum": [
        "announced",
        "permitting",
        "approved",
        "under_construction",
        "operational",
        "paused",
        "cancelled"
      ]
    },
    "status_source_id": {
      "type": "string"
    },
    "capacity": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "value",
        "unit",
        "source_id"
      ],
      "properties": {
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "source_id": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "start"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "enum": [
              "construction",
              "operations"
            ]
          },
          "start": {
            "type": [
              "string",
              "null"
            ],
            "description": "YYYY, YYYY-MM, YYYY-MM-DD, or YYYY-H1/H2"
          },
          "end": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_id": {
            "type": "string"
          },
          "estimated": {
            "type": "boolean",
            "description": "true if any date is inferred rather than stated by the source."
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "expected_completion": {
      "type": [
        "object",
        "null"
      ],
      "description": "Expected completion date, only as stated by a source.",
      "required": [
        "value",
        "basis",
        "source_id"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "string",
          "description": "YYYY, YYYY-MM, YYYY-MM-DD or YYYY-H1/H2"
        },
        "basis": {
          "enum": [
            "construction_complete",
            "first_operations",
            "full_operations"
          ]
        },
        "source_id": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "jobs": {
      "type": "array",
      "description": "Expected job creation, only as stated by a source. One entry per kind of figure.",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "value",
          "source_id"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "permanent_direct",
              "permanent_indirect",
              "permanent_total",
              "construction_peak",
              "construction_total"
            ],
            "description": "construction_peak = workers on site at peak; construction_total = construction jobs over the whole build."
          },
          "value": {
            "type": "integer",
            "minimum": 0
          },
          "source_id": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "contractors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "role",
          "source_id"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "enum": [
              "epc",
              "engineering_procurement",
              "general_contractor",
              "technology_licensor",
              "equipment_supplier",
              "civil_works",
              "services",
              "other"
            ]
          },
          "source_id": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "site_acres": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "value",
        "source_id"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0
        },
        "source_id": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "permits": {
      "type": "array",
      "description": "Permit, docket and authorization numbers. Only entries with an identifying number.",
      "items": {
        "type": "object",
        "required": [
          "agency",
          "type",
          "number",
          "source_id"
        ],
        "additionalProperties": false,
        "properties": {
          "agency": {
            "enum": [
              "LDEQ",
              "LPSC",
              "FERC",
              "DOE",
              "USACE",
              "EPA",
              "parish",
              "other"
            ]
          },
          "type": {
            "type": "string"
          },
          "number": {
            "type": "string"
          },
          "date": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "draft",
              "issued",
              "pending",
              "amended"
            ]
          },
          "source_id": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "itep": {
      "type": [
        "object",
        "null"
      ],
      "description": "Louisiana Industrial Tax Exemption Program application.",
      "required": [
        "application_number",
        "source_id"
      ],
      "additionalProperties": false,
      "properties": {
        "application_number": {
          "type": "string"
        },
        "approved_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_id": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "procurement_links": {
      "type": "array",
      "description": "Company-level supplier or vendor registration pages. Never named individuals.",
      "items": {
        "type": "object",
        "required": [
          "url",
          "label"
        ],
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "label": {
            "type": "string"
          },
          "source_id": {
            "type": "string"
          }
        }
      }
    },
    "estimate_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "confidence": {
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW"
      ]
    },
    "first_seen": {
      "type": "string",
      "format": "date"
    },
    "last_verified": {
      "type": "string",
      "format": "date"
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
